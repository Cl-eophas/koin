# ─── Required ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wms_db
JWT_SECRET=replace-with-64-plus-random-characters-use-openssl-rand-hex-32

# ─── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
TRUST_PROXY=1
LOG_LEVEL=info

# ─── CORS / URLs ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
# Used to build links in emails (password reset, meeting invites). Point
# this at wherever the web/ frontend is actually served — :3000 in local
# dev with `npm run dev`, or your real domain in production.
PUBLIC_APP_URL=http://localhost:3000/

# ─── Security (optional) ────────────────────────────────────────
# Comma-separated IPs allowed to call POST /api/public/seed (disabled in production)
# SEED_ADMIN_KEY=
VPNAPI_KEY=

# ─── Google OAuth (optional) ────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── SMTP (optional) ────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ─── Concurrency / scaling (all optional — defaults are free-tier-safe) ───
# How many Node worker processes to run. Leave at 1 (default) unless you've
# also set REDIS_URL below — with >1 worker and no Redis, Socket.IO
# broadcasts only reach clients on the worker that emitted them.
# WEB_CONCURRENCY=1

# Explicit MongoDB connection pool size per process. 20 is plenty for a
# small deployment and leaves headroom on a free MongoDB Atlas (M0) cluster,
# which caps around 500 total connections.
# MONGO_MAX_POOL_SIZE=20

# Only needed if you set WEB_CONCURRENCY above 1 (lets Socket.IO share
# broadcasts across workers/instances via Redis pub/sub). A free tier works
# fine — e.g. Upstash (upstash.com, no credit card) or Redis Cloud's free
# 30MB tier. Use the rediss:// (TLS) URL they give you.
# REDIS_URL=

# ─── Test accounts (npm run seed) ───
# One password for every test account. Use it only on a test database. Leave unset to generate one.
# SEED_PASSWORD=
